PORT=3002
CLIENT_URL=http://localhost:5180
MONGO_URI=mongodb+srv://user:password@your-cluster.mongodb.net/prime-gym?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Prime Gym <no-reply@primegym.com>
# Auth cookies. Defaults to "lax" locally and "none" when NODE_ENV=production
# (client and API on different sites, e.g. Render). Override only if both are
# served from the same site. NODE_ENV=production and CLIENT_URL (the exact
# client origin) must be set on the deployed server.
#COOKIE_SAMESITE=lax
